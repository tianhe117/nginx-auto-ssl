# Aliyun DNS API 密钥（必填）
ALIYUN_AK_ID=your_aliyun_access_key_id
ALIYUN_AK_SECRET=your_aliyun_access_key_secret

# 域名列表 — 分号分隔，每个域会自动申请根域名 + 泛域名证书
# 示例: example1.com;example2.com;example3.com
# 效果: 每行生成一张 SAN 证书，包含 domain 和 *.domain
DOMAINS=example1.com;example2.com

# Let's Encrypt 通知邮箱
CERT_EMAIL=admin@example.com
